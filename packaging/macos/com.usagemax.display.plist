<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.usagemax.display</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME_DIRECTORY__/.local/bin/usagemax-display</string>
    <string>--config</string>
    <string>__HOME_DIRECTORY__/.config/usagemax-display/config.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME_DIRECTORY__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME_DIRECTORY__/Library/Logs/usagemax-display.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME_DIRECTORY__/Library/Logs/usagemax-display.log</string>
</dict>
</plist>
